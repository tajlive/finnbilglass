{
  "name": "finnbilglass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Finnbilglass B2C bilglass — frontrute-matcher Worker + Pages-nettbutikk",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:serie && npm run test:fusion && npm run test:pipeline && npm run test:tecdoc && npm run test:resolver && npm run test:kill-switch && npm run test:fasit-integritet && npm run test:gt-generator",
    "test:fasit-integritet": "node --test tests/fasit-integritet.test.mjs",
    "test:gt-generator": "node --import tsx --test tests/er-frontrute.test.mjs",
    "test:serie": "node --import tsx --test tests/serie-mapping.test.mjs",
    "test:fusion": "node --import tsx --test tests/evidence-fusion.test.mjs tests/image-resolver.test.mjs",
    "test:pipeline": "node --test tests/crosswalk-pipeline.test.mjs",
    "test:tecdoc": "node --test tests/tecdoc-snapshot-import.test.mjs",
    "test:resolver": "node --import tsx --test tests/resolver-sporsmaal.test.mjs",
    "test:kill-switch": "node --import tsx --test tests/kill-switch.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "tsx": "^4.23.12",
    "typescript": "^5.8.0",
    "wrangler": "^4.122.0"
  }
}
