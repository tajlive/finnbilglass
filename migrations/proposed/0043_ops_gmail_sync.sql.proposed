-- PROPOSAL ONLY. Gmail mirror tables belong in the same D1 as beta_inquiries,
-- manual offers and orders. Never point staging at the legacy staging-auth D1.
PRAGMA foreign_keys = ON;

CREATE TABLE IF NOT EXISTS ops_messages (
  id TEXT PRIMARY KEY,
  inquiry_id INTEGER REFERENCES beta_inquiries(id),
  request_id TEXT NOT NULL UNIQUE,
  direction TEXT NOT NULL CHECK(direction IN ('IN','OUT')),
  recipient TEXT NOT NULL,
  subject TEXT NOT NULL,
  body TEXT NOT NULL,
  status TEXT NOT NULL,
  provider_id TEXT UNIQUE,
  actor TEXT NOT NULL,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  error TEXT,
  send_reserved_at INTEGER
);
CREATE INDEX IF NOT EXISTS idx_ops_messages_case ON ops_messages(inquiry_id,created_at);
CREATE INDEX IF NOT EXISTS idx_ops_messages_status ON ops_messages(status,created_at);

CREATE TABLE IF NOT EXISTS ops_mail_details (
  provider_id TEXT PRIMARY KEY,
  source TEXT NOT NULL,
  rfc_message_id TEXT,
  headers_json TEXT NOT NULL DEFAULT '{}',
  attachments_json TEXT NOT NULL DEFAULT '[]'
);
CREATE INDEX IF NOT EXISTS idx_ops_mail_rfc ON ops_mail_details(rfc_message_id);

CREATE TABLE IF NOT EXISTS ops_mail_sync_state (
  channel TEXT PRIMARY KEY,
  last_success INTEGER,
  last_error TEXT,
  updated_at INTEGER NOT NULL,
  history_id TEXT
);
CREATE TABLE IF NOT EXISTS ops_mail_events (
  id TEXT PRIMARY KEY,
  provider_id TEXT NOT NULL,
  event_type TEXT NOT NULL,
  occurred_at INTEGER NOT NULL,
  payload_json TEXT NOT NULL,
  processed INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX IF NOT EXISTS idx_ops_mail_provider ON ops_mail_events(provider_id,occurred_at);

CREATE TABLE IF NOT EXISTS ops_work_events (
  id TEXT PRIMARY KEY,
  inquiry_id INTEGER NOT NULL REFERENCES beta_inquiries(id),
  kind TEXT NOT NULL,
  body TEXT NOT NULL,
  actor TEXT NOT NULL,
  created_at INTEGER NOT NULL
);
CREATE INDEX IF NOT EXISTS idx_ops_work_events_case ON ops_work_events(inquiry_id,created_at);
