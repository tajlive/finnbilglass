-- Staging proposal: one-time Google Workspace Gmail read-only OAuth connection.
-- Same isolated EU D1 as OPS cases. No mailbox data and no tokens in cleartext.
-- Apply only after reviewed SQL rehearsal and D1 Time Travel bookmark.
CREATE TABLE IF NOT EXISTS ops_workspace_oauth_attempts (
  state TEXT PRIMARY KEY CHECK(length(state)=64),
  actor_email TEXT NOT NULL,
  verifier_ciphertext TEXT NOT NULL,
  created_at INTEGER NOT NULL,
  expires_at INTEGER NOT NULL,
  consumed_at INTEGER,
  CHECK (expires_at > created_at)
);
CREATE INDEX IF NOT EXISTS idx_ops_workspace_oauth_expiry
  ON ops_workspace_oauth_attempts(expires_at, consumed_at);

CREATE TABLE IF NOT EXISTS ops_workspace_gmail_tokens (
  id TEXT PRIMARY KEY CHECK(id='primary'),
  mailbox TEXT NOT NULL,
  refresh_ciphertext TEXT NOT NULL,
  scope TEXT NOT NULL,
  connected_by TEXT NOT NULL,
  connected_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  status TEXT NOT NULL DEFAULT 'ACTIVE'
    CHECK(status IN ('ACTIVE','DISCONNECTED'))
);

CREATE TABLE IF NOT EXISTS ops_workspace_oauth_audit (
  id TEXT PRIMARY KEY,
  actor_email TEXT NOT NULL,
  action TEXT NOT NULL CHECK(action IN ('CONNECTED','DISCONNECTED')),
  mailbox TEXT NOT NULL,
  created_at INTEGER NOT NULL
);
CREATE TRIGGER IF NOT EXISTS ops_workspace_oauth_audit_append_only_update
  BEFORE UPDATE ON ops_workspace_oauth_audit
BEGIN SELECT RAISE(ABORT,'WORKSPACE_AUDIT_IMMUTABLE'); END;
CREATE TRIGGER IF NOT EXISTS ops_workspace_oauth_audit_append_only_delete
  BEFORE DELETE ON ops_workspace_oauth_audit
BEGIN SELECT RAISE(ABORT,'WORKSPACE_AUDIT_IMMUTABLE'); END;
